{
  "name": "sippol-integrator",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "module": "src/app.ts",
  "scripts": {
    "start": "bun run src/app.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "compile": "bun build --compile --outfile dist/app src/app.ts",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun run test && bun run compile"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^7"
  }
}
