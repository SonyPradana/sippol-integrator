# Copy to .env and fill in the credentials.
#
# Every key is prefixed with SIMPUS_ on purpose. An unprefixed USERNAME is already
# set on Windows to the logged-in user, and dotenv does not override an existing
# variable, so the app would silently log in as the wrong account.

# Origin only, no trailing slash.
SIMPUS_HOST=http://HOST

# Must start with "/". These are rendered by the server into the date inputs
# that the page's own click handler reads.
SIMPUS_LOGIN_PATH=/LOGIN-PATH
SIMPUS_TARGET_PATH=/TARGET-PATH

SIMPUS_USERNAME=
SIMPUS_PASSWORD=

# How long to wait for the result alert before giving up, in milliseconds.
SIMPUS_TIMEOUT_MS=120000