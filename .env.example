# Copy to .env and fill in the credentials.

# Origin only, no trailing slash.
HOST=http://HOST

# Must start with "/". These are rendered by the server into the date inputs
# that the page's own click handler reads.
LOGIN_PATH=/LOGIN-PATH
TARGET_PATH=/TARGET-PATH

USERNAME=
PASSWORD=

# How long to wait for the result alert before giving up, in milliseconds.
TIMEOUT_MS=120000